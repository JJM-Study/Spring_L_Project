<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.myproject.gis.mapper.GeoCordingMapper">
    <select id="findGeocodingTargets" resultType="org.example.myproject.gis.dto.GeoCordCommonDto$GeoTarget">
        select location_id, address
        from tb_selling_location
        where address is not null
        and TRIM(address) &lt; > ''
        and latitude is null
        and longitude is null;
    </select>
</mapper>
